# Takoyaki desu : bloc à ajouter au Caddyfile du VPS (remplacer le nom de domaine).
# Caddy obtient et renouvelle le certificat HTTPS tout seul (indispensable pour une PWA).
takoyaki.example.com {
	root * /srv/takoyaki-desu
	encode zstd gzip

	# Le service worker et le manifeste ne doivent jamais rester en cache :
	# c'est par eux que les mises à jour arrivent.
	@fresh path /sw.js /registerSW.js /manifest.webmanifest /index.html /
	header @fresh Cache-Control "no-cache"

	# Les fichiers de build ont un nom qui change à chaque version : cache long.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	file_server
}
